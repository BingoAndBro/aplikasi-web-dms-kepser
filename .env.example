# ============================================
# APLIKASI
# ============================================

# Environment aplikasi
# Jangan set NODE_ENV di sini — biarkan Vite menentukannya otomatis
# (development untuk `pnpm dev`, production untuk `pnpm build`).
# Men-set NODE_ENV=development secara eksplisit akan membuat hasil
# `pnpm build` tetap berperilaku seperti mode dev (mis. debug log GUARD ikut ke bundle produksi).

DATABASE_URL=postgresql://kepser:kepser_dev_password@localhost:5432/kepser_workflow
DMS_LOCAL_STORAGE_ROOT=storage
DMS_FILE_TOKEN_SECRET=replace-with-long-random-secret

# Base URL aplikasi (untuk redirect after login)
# Harus sama persis dengan origin di address bar browser (skema + host + port).
# Dev server pakai basicSsl() -> HTTPS, jadi origin-nya https://localhost:3000
# Production: https://yourdomain.com
APP_URL=https://localhost:3000

DMS_SESSION_COOKIE_SECURE=false
