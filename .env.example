# ============================================
# SUPABASE — Ambil dari dashboard.supabase.com
# ============================================

# URL project Supabase Anda
# Dashboard → Settings → API → Project URL
SUPABASE_URL=https://pnybphfqiitnxfnfoydo.supabase.co

# Anonymous/Public Key (aman untuk client-side)
# Dashboard → Settings → API → Project API keys → anon/public
SUPABASE_ANON_KEY=REDACTED_JWT

# Service Role Key (HANYA untuk server-side, JANGAN expose ke client)
# Dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=REDACTED_JWT

# Database URL — Ambil dari Supabase Dashboard
# Settings → Database → Connection info → URI
DATABASE_URL=postgresql://postgres.[region]:[password]@aws-[region]-[id].compute.amazonaws.com:5432/postgres

# ============================================
# APLIKASI
# ============================================

# Environment aplikasi
NODE_ENV=development

# Base URL aplikasi (untuk redirect after login)
APP_URL=http://localhost:3000

# Base URL aplikasi (untuk redirect after login)
# Development: http://localhost:3000
# Production: https://yourdomain.com
APP_URL=http://localhost:3000
